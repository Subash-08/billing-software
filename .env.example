# NIRAMAALAI SaaS Billing Software — Staging / Production Environment Variables
# Copy this file to .env and replace placeholders with secure credentials.
# NEVER commit real production credentials or API keys to source control.

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://billing.niramaalai.com
CORS_ALLOWED_ORIGINS=https://billing.niramaalai.com,https://staging.niramaalai.com

# -----------------------------------------------------------------------------
# MONGODB DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# MONGODB_URI: Full connection string to MongoDB Atlas replica set
# Ensure IP Whitelisting is configured in Atlas Security settings.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/<db_name>?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# AUTHENTICATION & SESSION SECURITY
# -----------------------------------------------------------------------------
# JWT_SECRET: Minimum 32-character high-entropy secret string for session tokens
JWT_SECRET=production_super_secret_jwt_key_min_32_chars_long_123456789
SESSION_COOKIE_NAME=niramaalai_session
SESSION_MAX_AGE_SECONDS=604800 # 7 Days

# -----------------------------------------------------------------------------
# E-INVOICE GSP (GOVERNMENT SERVICES PROVIDER) INTEGRATION
# -----------------------------------------------------------------------------
# Configure authorized GSP partner credentials for live IRN generation.
# When missing, system operates in boundary mode ('NOT_CONFIGURED').
EINVOICE_GSP_ENVIRONMENT=sandbox # sandbox | production
EINVOICE_GSP_CLIENT_ID=
EINVOICE_GSP_CLIENT_SECRET=
EINVOICE_GSTIN_USER=
EINVOICE_GSTIN_PASSWORD=

# -----------------------------------------------------------------------------
# E-WAY BILL GSP INTEGRATION
# -----------------------------------------------------------------------------
EWAYBILL_GSP_ENVIRONMENT=sandbox # sandbox | production
EWAYBILL_GSP_CLIENT_ID=
EWAYBILL_GSP_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# STORAGE & PDF GENERATION
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local # local | s3
S3_BUCKET_NAME=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
